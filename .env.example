# 이 프로젝트에서 사용하는 환경변수 목록. 실제 값은 .env에 채운다 (.env는 커밋되지 않음).

# Supabase — 프로젝트 설정 > API 에서 확인 (Google OAuth 클라이언트 ID/Secret은 여기가 아니라
# Supabase 대시보드의 Auth > Providers > Google 에 등록한다, 앱 환경변수 아님)
# 위치: Supabase 대시보드 → 프로젝트 → Project Settings(좌하단 톱니바퀴) → API 탭
# NEXT_PUBLIC_SUPABASE_URL: "Project URL" 항목 (예: https://<project-ref>.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY: 같은 API 탭의 "anon public" 키
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY: 같은 API 탭의 "service_role" 키 (Legacy API Keys 섹션) — 절대 클라이언트에 노출 금지
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic (Claude API) — services/claude.ts 전용
# 위치: console.anthropic.com → API Keys → Create Key
ANTHROPIC_API_KEY=

# Polar — services/polar.ts 전용
# 위치: polar.sh → 조직 생성 후 Settings → Access Tokens → Create Token
POLAR_ACCESS_TOKEN=
# POLAR_WEBHOOK_SECRET: 웹훅 엔드포인트 등록 시 발급 (배포 URL 필요) — 비어 있으면 서명 검증을
# 생략하는 대신 verifyAndParseWebhook이 즉시 에러를 던진다(fail-closed), 값이 채워지기 전까지 웹훅은 동작하지 않는다.
POLAR_WEBHOOK_SECRET=
# POLAR_PRODUCT_ID: 단일 Pro 구독 상품의 ID (ADR-006)
# 위치: polar.sh 대시보드 → Products → Pro 상품 생성 후 Product ID 확인
POLAR_PRODUCT_ID=

# 앱 기본 URL — OAuth 콜백, Polar 체크아웃 success/cancel URL 등에 사용
NEXT_PUBLIC_APP_URL=http://localhost:3000

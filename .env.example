# 이 프로젝트에서 사용하는 환경변수 목록. 실제 값은 .env에 채운다 (.env는 커밋되지 않음).

# Supabase — 프로젝트 설정 > API 에서 확인 (Google OAuth 클라이언트 ID/Secret은 여기가 아니라
# Supabase 대시보드의 Auth > Providers > Google 에 등록한다, 앱 환경변수 아님)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic (Claude API) — services/claude.ts 전용
ANTHROPIC_API_KEY=

# Polar — services/polar.ts 전용
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=

# 앱 기본 URL — OAuth 콜백, Polar 체크아웃 success/cancel URL 등에 사용
NEXT_PUBLIC_APP_URL=http://localhost:3000
